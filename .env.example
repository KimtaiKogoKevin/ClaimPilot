# =============================================================================
# DATABASE
# =============================================================================
# Primary connection string (required)
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/claims_platform

# Individual PG vars (used by some tooling; DATABASE_URL takes precedence at runtime)
PGHOST=localhost
PGPORT=5432
PGDATABASE=claims_platform
PGUSER=postgres
PGPASSWORD=yourpassword

# =============================================================================
# SECURITY
# =============================================================================
# Session secret for express-session cookie signing (required)
SESSION_SECRET=your-random-session-secret-change-this

# JWT secret for standalone auth token signing (required for standalone mode)
JWT_SECRET=your-random-jwt-secret-change-this

# JWT token expiration (optional, default: 7d)
# JWT_EXPIRES_IN=7d

# =============================================================================
# SERVER
# =============================================================================
PORT=5000
NODE_ENV=development

# =============================================================================
# FILE STORAGE
# =============================================================================
# Directories for local file uploads (used when not on Replit object storage)
PRIVATE_OBJECT_DIR=./uploads/private
PUBLIC_OBJECT_SEARCH_PATHS=./uploads/public

# Max upload size in bytes (optional, default: 10485760 = 10 MB)
# MAX_FILE_SIZE=10485760

# Custom upload directory root (optional, default: ./uploads)
# UPLOAD_DIR=./uploads

# =============================================================================
# EMAIL (optional — for password-reset emails)
# =============================================================================
# The app works without email; password-reset links are logged to the console
# in development mode when email is not configured.
#
# For testing use Mailtrap (free at https://mailtrap.io):
# EMAIL_HOST=sandbox.smtp.mailtrap.io
# EMAIL_PORT=587
# EMAIL_USER=your_mailtrap_user
# EMAIL_PASS=your_mailtrap_pass
#
# Alternatively set EMAIL_SERVICE for well-known providers (gmail, outlook, etc.):
# EMAIL_SERVICE=gmail
#
# Sender address shown in outgoing emails (defaults to EMAIL_USER):
# EMAIL_FROM=noreply@yourdomain.com

# =============================================================================
# AI / COMPUTER VISION (optional — damage analysis)
# =============================================================================
# Sign up at https://roboflow.com for an API key.
# Without these vars, AI analysis is skipped and photos are stored only.
# ROBOFLOW_API_KEY=your_roboflow_api_key
# ROBOFLOW_VEHICLE_MODEL_ID=vehicle-damage-model
# ROBOFLOW_GOODS_MODEL_ID=goods-damage-model

# Set to 'true' to enable AI analysis in standalone mode (server/standalone.ts)
# ENABLE_AI_ANALYSIS=true

# =============================================================================
# REPLIT-ONLY (auto-set by the Replit environment — do not set locally)
# =============================================================================
# REPL_ID            — detected at runtime to switch auth mode
# REPLIT_DOMAINS     — used by Replit Auth OIDC flow
# ISSUER_URL         — OIDC issuer (defaults to https://replit.com/oidc)
